{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Wander Asia website on Cloudflare Workers, built with OpenNext (npm run deploy)
  "name": "wanderasia-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "services": [
    // Lets the site call itself (needed by OpenNext)
    { "binding": "WORKER_SELF_REFERENCE", "service": "wanderasia-web" },
    // Private link to the Plyndi CMS Worker in the same Cloudflare account
    { "binding": "CMS", "service": "wanderasia-cms" }
  ],
  "vars": {
    "CMS_API_URL": "https://wanderasia-cms.wanderasia.workers.dev",
    "SITE_URL": "https://wanderasia.tw"
  }
}
